# RM's SYSGEN 4.0D copies the system tracks from drive A to drive B: 0E for track 0 and 03 (write without
# verify) for the rest. "SYSTEM copy completed".
drive A 480Z_RML_system-cpm2.2f-basic5.3g-basic6.3b.imd
drive B 480Z_RML_system-cpm2.2f-basic5.3g-basic6.3b.imd
seconds 52
type 2.0 B
type 12 SYSGEN\r
type 18 \r
type 21 A
type 25 \r
type 32 B
type 37 \r
