+#ifndef MAME_RM_RMFE_LINK_H
+#define MAME_RM_RMFE_LINK_H
+
+#pragma once
+
+#include "bus/rs232/rs232.h"
+#include "diserial.h"
+#include "osdfile.h"
+
+#include <cstdio>
+#include <deque>
+#include <string>
+
+class rmfe_link_device : public device_t, public device_serial_interface, public device_rs232_port_interface
+{
+public:
+	rmfe_link_device(const machine_config &mconfig, const char *tag, device_t *owner, uint32_t clock);
+	~rmfe_link_device();
+
+	virtual void input_txd(int state) override { device_serial_interface::rx_w(state); }
+	virtual void input_rts(int state) override;
+	virtual void input_dtr(int state) override;
+
+protected:
+	virtual void device_start() override ATTR_COLD;
+	virtual void device_reset() override ATTR_COLD;
+	virtual void device_stop() override ATTR_COLD;
+
+	virtual void tra_callback() override;
+	virtual void tra_complete() override;
+	virtual void rcv_complete() override;
+
+private:
+	TIMER_CALLBACK_MEMBER(poll);
+	void send_msg(uint8_t type, uint8_t value);
+	void send_lines();
+	void set_fast(bool fast);
+	void start_next();
+	void connect();
+	void disconnect(const char *why);
+	void flush();
+	void log(const char *what, int value);
+
+	std::string m_address;
+	osd_file::ptr m_sock;
+	std::string m_out; // messages not yet written to the socket
+	attotime m_next_connect;
+	emu_timer *m_poll_timer;
+	std::deque<uint8_t> m_to_480z;
+	uint8_t m_msg[2];
+	int m_msg_len;
+	int m_rts; // the 480Z's RTS and DTR, as pin levels (0 = asserted)
+	int m_dtr;
+	bool m_fast;
+	bool m_go_fast_asked; // the 480Z sent 00 at 9600
+	int m_go_fast_matched; // how much of 5A 00 01 has been relayed since
+	bool m_switch_after_tx;
+	int m_slack; // bytes that may still start after the 480Z drops DTR (RMFE_LINK_DTR_SLACK; 0 = as the IDC)
+	int m_slack_used;
+	int m_unit_cts; // the unit's lines as last reported by the bridge, as pin levels (0 = asserted)
+	int m_unit_dcd;
+	FILE *m_log;
+};
+
+DECLARE_DEVICE_TYPE(RMFE_LINK, rmfe_link_device)
+
+#endif // MAME_RM_RMFE_LINK_H
